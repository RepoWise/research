flowchart TD
    FE["Chat Interface"]:::frontend
    API["REST API"]:::api
    IC["**Intent Classifier**\n*LLM Few-Shot CoT*\n*(97.6% Accuracy)*"]:::classifier

    subgraph QP["Query Processors"]
        RAG["RAG Engine"]:::qpInner
        DQE["Data Query Engine"]:::qpInner
        SR["Static Response"]:::static
    end

    LLM["LLM Client\n*Mistral 7B*"]:::llm

    subgraph EXT["External Services"]
        GH["GitHub API"]:::extInner
        OL["Ollama Server"]:::extInner
    end

    subgraph STORE["Storage Layer"]
        CDB[("ChromaDB\nVector Store")]:::storageNode
        DFC[("DataFrame Cache\nCommits/Issues")]:::storageNode
    end

    FE -->|Query| API
    API --> IC

    IC -->|PROJECT_DOC_BASED| RAG
    IC -->|COMMITS/ISSUES| DQE
    IC -.->|OUT_OF_SCOPE| SR
    IC -->|GENERAL| RAG

    RAG -->|Context| LLM
    DQE -->|Context| LLM

    LLM -->|Generate| OL

    SR -.->|Fixed Message| API
    LLM -->|Generated Response| API

    RAG -->|Semantic Search| CDB
    DQE -->|Pandas Query| DFC

    GH -.->|Fetch Docs| CDB
    GH -.->|Fetch Commits & Issues| DFC

